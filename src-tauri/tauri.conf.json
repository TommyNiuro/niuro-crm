{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niuro CRM",
  "version": "0.2.1",
  "identifier": "io.niuro.crm",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Niuro CRM",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tomás Ffrench-Davis",
    "copyright": "© 2026 Tomás Ffrench-Davis (iam@tomasffrenchdavis.com)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/server", "resources/bridge/*"],
    "category": "Business",
    "shortDescription": "CRM local-first con UX estilo Twenty",
    "longDescription": "Niuro CRM corre entero en tu Mac sobre Next.js + SQLite, con IA opcional via el CLI claude. Empaquetado como app nativa con Tauri."
  }
}
