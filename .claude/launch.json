{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "autocrm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3001
    },
    {
      "name": "autocrm-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3017"],
      "port": 3017
    },
    {
      "name": "niuro-twenty",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "CRM_DB_PATH=$PWD/data/crm.dev.db npx next dev -p 3030"],
      "port": 3030
    }
  ]
}
