# Niuro CRM - Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local
#
# IMPORTANTE: la IA va por subprocess del CLI `claude` con auth Max.
# NUNCA configures ANTHROPIC_API_KEY: interfiere con la auth Max del CLI.

# =============================================================================
# Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Niuro CRM <onboarding@resend.dev>

# =============================================================================
# Propuestas (opcional)
# =============================================================================
# CC fijo en cada mail de propuesta. Se inlinea al buildear (client component),
# así que seteala ANTES de `npm run build` / `npm run desktop:build`.
# NEXT_PUBLIC_PROPOSAL_CC=alguien@tuempresa.com

# =============================================================================
# Operador / marca (tu identidad; la IA y la UI la usan)
# =============================================================================
# OPCIONAL: el primer arranque abre un onboarding que guarda esto en la DB (runtime,
# sin rebuild). Estas vars son solo el fallback/pre-seed antes de completarlo; si las
# dejás, el onboarding aparece pre-llenado con estos valores.
# OPERATOR_NAME=Operador
# OPERATOR_ROLE=Ventas
# OPERATOR_EMAIL=operador@example.com
# COMPANY_NAME=Tu Empresa
# COMPANY_PITCH=una empresa de servicios

# =============================================================================
# WhatsApp bridge (defaults correctos para la instalación estándar)
# =============================================================================
# WHATSAPP_DB_PATH=./data/whatsapp/messages.db
# WHATSAPP_STORE_DB_PATH=./data/whatsapp/whatsapp.db
# WHATSAPP_BRIDGE_URL=http://localhost:8790
# WHATSAPP_SINCE=2024-12-01

# =============================================================================
# IA (opcional: override del binario del CLI; por defecto se resuelve solo)
# =============================================================================
# CLAUDE_BIN=/ruta/al/claude

# =============================================================================
# Observabilidad (opcional: si se setea, los logger.error() se postean acá;
# sin esto, los errores solo van a stdout/launchd). Puede ser una ingest URL de
# Sentry, un webhook de Slack, o cualquier endpoint que acepte JSON.
# =============================================================================
# ERROR_WEBHOOK_URL=https://...

# =============================================================================
# HubSpot (solo para importación one-shot)
# =============================================================================
# HUBSPOT_API_KEY=pat-...
